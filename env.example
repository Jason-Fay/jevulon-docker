# server/deploy/docker/env.example — copy to .env, fill in, `chmod 600 .env`, never commit .env.
# (Named without the leading dot on purpose: the repo's .gitignore `.env.*` would hide it.)
# Consumed by compose.yaml (env_file + ${…} interpolation). The Helm chart holds the same
# material in a Kubernetes Secret instead (see the runbook in server/deploy/README.md).

# Required — the plane refuses to start without these (server/main.ts).
#   openssl rand -base64 32   → CONTROL_PLANE_ENC_KEY (BYOK at-rest master key)
#   openssl rand -hex 24      → each ss_…-style issued app token (share once, store the value)
CONTROL_PLANE_ENC_KEY=
SENTINEL_TOKENS=

# Customer-owned JEV credential (BYOK — PROJECT_PHASES.md data model). Optional: needed only for
# live adjudication (CONTROL_PLANE.md §4). It lives here / in the Kubernetes Secret only — never
# in images, values files, or headers on the inbound side.
# JEV_API_KEY=

# JEV upstream. Optional. For zero external egress this MUST be a private or local endpoint:
# BYOK alone controls account ownership, not physical network locality.
# JEV_ENDPOINT=
# JEV_MODEL=
# JEV_TIMEOUT_MS=15000

# Explicit no-contribution (contract #5): 1 = enterprise data never feeds the shared corpus.
# This is the shipped default for private deployments — change it only deliberately.
SENTINEL_NO_CONTRIBUTION=1

# Stripe checkout (the buy buttons hot-link GET /v1/checkout?tier=pro|team|docker on this plane).
#   STRIPE_SECRET_KEY   — restricted key with Checkout write access (sk_live_/sk_test_)
#   STRIPE_PRICE_*      — the Price IDs for each plan from the Stripe dashboard (Products → Prices)
#   STRIPE_WEBHOOK_SECRET — shared secret the Stripe webhook endpoint expects
# The webhook endpoint to point at Stripe: https://api.jevulon.com/webhooks/stripe (event:
# checkout.session.completed) — it provisions the tenant and mails the signed license token.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_DOCKER=
STRIPE_WEBHOOK_SECRET=
# Optional overrides for where Stripe sends buyers back (defaults shown).
# STRIPE_SUCCESS_URL=https://jevulon.com/?checkout=success#get-started
# STRIPE_CANCEL_URL=https://jevulon.com/#pricing

# Paid-feature licensing (Pro code-review sieve).
# JVII_LICENSE_SIGNING_KEY is the Ed25519 private key that signs customer license tokens at
# checkout/signup. Paste the full PEM contents of secrets/license-signing.pem (from the
# workstation) as a single line with literal \n between the header, body, and footer lines.
# Without it, provisioning still issues API tokens but no offline JVII_TOKEN licenses.
# JVII_LICENSE_SIGNING_KEY=

# JVII_LICENSE_PUBLIC_KEY is optional — it is already embedded in src/license.ts; set it only to
# rotate to a new signing key before a release ships the new verifying key.
# JVII_LICENSE_PUBLIC_KEY=
